# ============================================================
#  বিদ্যুৎ বন্ধু — কনফিগারেশন
#  এই ফাইলটা কপি করে .env বানান:  cp .env.example .env
# ============================================================

# ---------------- মিটার / প্রোভাইডার ----------------
# desco | dpdc | demo   (demo = নমুনা ডেটা, মিটার ছাড়াই সব দেখা যায়)
PROVIDER=demo

# DESCO Account No. / DPDC Customer No.
ACCOUNT_NO=12345678

# বিলে লেখা অনুমোদিত লোড (kW)
SANCTION_LOAD_KW=2

# single | three
PHASE=single

# নাম নিজে দিতে চাইলে (খালি রাখলে মিটার API থেকে আসবে)
CUSTOMER_NAME=

# ---------------- সতর্কতার সীমা ----------------
# ব্যালেন্স এই টাকার নিচে নামলে সতর্কতা
LOW_BALANCE_TK=300

# এর নিচে নামলে জরুরি সতর্কতা
CRITICAL_BALANCE_TK=150

# মাসিক খরচের বাজেট (0 দিলে বাজেট অ্যালার্ট বন্ধ)
MONTHLY_BUDGET_TK=2500

# দৈনিক খরচ গড়ের এই গুণের বেশি হলে অস্বাভাবিক ধরা হবে
ANOMALY_MULTIPLIER=1.5

# কত দিনের কম বাকি থাকলে অ্যালার্ট
DAYS_LEFT_WARNING=3

# বাজেটের কত শতাংশ খরচ হলে সতর্কতা
BUDGET_WARNING_PCT=80

# ---------------- পোলিং ও রিপোর্ট ----------------
# কত মিনিট পর পর ব্যালেন্স চেক হবে
POLL_MINUTES=30

# দৈনিক রিপোর্ট কখন (০–২৩ ঘণ্টা, ঢাকার সময়)
REPORT_HOUR=9

TIMEZONE=Asia/Dhaka

# ক্যাশ কত সেকেন্ড রাখা হবে (বারবার API কলে ব্লক এড়াতে)
CACHE_SECONDS=300

# কত মিনিটের বেশি পুরনো ডেটা হলে "রিডিং পুরনো" অ্যালার্ট
STALE_AFTER_MINUTES=180

# ---------------- টেলিগ্রাম (ঐচ্ছিক) ----------------
# @BotFather থেকে টোকেন
TELEGRAM_BOT_TOKEN=

# বটকে /id পাঠিয়ে যে নম্বর পাবেন, সেটা কমা দিয়ে দিন (একাধিক হলে: 123,456)
TELEGRAM_CHAT_IDS=

# ---------------- AI (ঐচ্ছিক) ----------------
# খালি থাকলে বিল্ট-ইন বাংলা এজেন্ট চলবে — কোনো key লাগে না।
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# OpenAI দিয়ে চাইলে:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---------------- সার্ভার ----------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ডেটা কোথায় জমা থাকবে (খালি রাখলে ./data)
DATA_DIR=
